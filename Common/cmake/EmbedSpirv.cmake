if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "INPUT, OUTPUT, and SYMBOL are required")
endif()

file(READ "${INPUT}" spirv_hex HEX)
string(LENGTH "${spirv_hex}" spirv_hex_length)
math(EXPR remainder "${spirv_hex_length} % 8")
if(NOT remainder EQUAL 0)
    message(FATAL_ERROR "SPIR-V file size is not a multiple of four bytes: ${INPUT}")
endif()

math(EXPR word_count "${spirv_hex_length} / 8")
file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\nnamespace mygame_shaders {\ninline constexpr std::uint32_t ${SYMBOL}[] = {\n")
if(word_count GREATER 0)
    math(EXPR last_word "${word_count} - 1")
    foreach(index RANGE 0 ${last_word})
        math(EXPR offset "${index} * 8")
        string(SUBSTRING "${spirv_hex}" ${offset} 2 byte0)
        math(EXPR offset1 "${offset} + 2")
        string(SUBSTRING "${spirv_hex}" ${offset1} 2 byte1)
        math(EXPR offset2 "${offset} + 4")
        string(SUBSTRING "${spirv_hex}" ${offset2} 2 byte2)
        math(EXPR offset3 "${offset} + 6")
        string(SUBSTRING "${spirv_hex}" ${offset3} 2 byte3)
        file(APPEND "${OUTPUT}" "0x${byte3}${byte2}${byte1}${byte0}u,\n")
    endforeach()
endif()
file(APPEND "${OUTPUT}" "};\n}\n")
